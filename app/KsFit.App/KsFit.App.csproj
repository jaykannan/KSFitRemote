<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows head. A future macOS/Linux/Android head adds its own IBleTransport and reuses Core + Views. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>KsFitRemote</AssemblyName>
    <Product>KS Fit Remote (unofficial)</Product>
    <AssemblyTitle>KS Fit Remote (unofficial)</AssemblyTitle>
    <Description>Unofficial community remote for KS Fit / WalkingPad treadmills. Not affiliated with KingSmith.</Description>
    <Company>Unofficial community project</Company>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Bump Version by hand for releases; BuildStamp (UTC yyyyMMdd.HHmm) is stamped on every build. -->
    <Version>1.0.0</Version>
    <BuildStamp>$([System.DateTime]::UtcNow.ToString("yyyyMMdd.HHmm"))</BuildStamp>
    <InformationalVersion>$(Version)+$(BuildStamp)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.3" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
    <AvaloniaResource Include="Assets\app.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\devices\*.png" CopyToOutputDirectory="PreserveNewest" LinkBase="Assets\devices" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KsFit.Core\KsFit.Core.csproj" />
  </ItemGroup>
</Project>
